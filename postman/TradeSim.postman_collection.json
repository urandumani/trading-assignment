{
  "info": {
    "name": "TradeSim API",
    "description": "Stock trading simulation API. Run the folders in order (Runner or Newman).\n\nThe collection logs in automatically (collection pre-request script) as {{username}} and keeps the JWT, userId and accountId in collection variables.\n\nThe Orders folder needs the market to be open (09:30–16:00 CEST, weekdays) — or start the stack with MARKET_ALWAYS_OPEN=true.\n\nNote: the spec's GET /api/v1/orders/{userId} is GET /api/v1/users/{userId}/orders here (both ids are UUIDs, so the two spec routes can't be told apart). The spec's example symbol AAPL is APXL here (instruments are fictional).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "tokenExpiresAt",
      "value": "0"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const isLogin = pm.request.url.getPath().endsWith(\"/auth/login\");",
          "const expiresAt = Number(pm.collectionVariables.get(\"tokenExpiresAt\") || 0);",
          "if (!isLogin && (!pm.collectionVariables.get(\"accessToken\") || Date.now() > expiresAt - 60000)) {",
          "    pm.sendRequest({",
          "        url: pm.variables.get(\"baseUrl\") + \"/api/v1/auth/login\",",
          "        method: \"POST\",",
          "        header: { \"Content-Type\": \"application/json\" },",
          "        body: { mode: \"raw\", raw: JSON.stringify({ username: pm.variables.get(\"username\"), password: pm.variables.get(\"password\") }) },",
          "    }, (error, response) => {",
          "        if (error || response.code !== 200) {",
          "            console.error(\"Automatic login failed\", error || response.text());",
          "            return;",
          "        }",
          "        const data = response.json().data;",
          "        pm.collectionVariables.set(\"accessToken\", data.accessToken);",
          "        pm.collectionVariables.set(\"tokenExpiresAt\", Date.now() + data.expiresIn * 1000);",
          "        pm.collectionVariables.set(\"userId\", data.userId);",
          "        pm.collectionVariables.set(\"accountId\", data.accountId);",
          "    });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if ((pm.response.headers.get(\"Content-Type\") || \"\").includes(\"json\") && !pm.request.url.getPath().startsWith(\"/health\")) {",
          "    pm.test(\"Response uses the envelope\", () => {",
          "        const body = pm.response.json();",
          "        pm.expect(body).to.have.all.keys(\"success\", \"data\", \"errors\");",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Seeded users: trader1–trader3 (cash accounts), trader4–trader5 (margin accounts). Password: Password123!",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 with a bearer token\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.tokenType).to.equal(\"Bearer\");",
                  "    pm.expect(data.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.collectionVariables.set(\"accessToken\", data.accessToken);",
                  "    pm.collectionVariables.set(\"tokenExpiresAt\", Date.now() + data.expiresIn * 1000);",
                  "    pm.collectionVariables.set(\"userId\", data.userId);",
                  "    pm.collectionVariables.set(\"accountId\", data.accountId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with a wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 INVALID_CREDENTIALS\", () => {",
                  "    pm.response.to.have.status(401);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.equal(false);",
                  "    pm.expect(body.data).to.equal(null);",
                  "    pm.expect(body.errors[0].code).to.equal(\"INVALID_CREDENTIALS\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{userId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 with my profile\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.userId).to.equal(pm.collectionVariables.get(\"userId\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
