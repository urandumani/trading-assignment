    {
      "name": "3. Orders (market must be open)",
      "item": [
        {
          "name": "Market buy (the spec's example)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"timeInForce\": \"DAY\",\n  \"limitPrice\": null,\n  \"instrumentSymbol\": \"APXL\",\n  \"orderType\": \"MARKET\",\n  \"side\": \"BUY\",\n  \"quantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 FILLED with execution details\", () => {",
                  "    pm.response.to.have.status(201);",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.status).to.equal(\"FILLED\");",
                  "    pm.expect(data.executedQuantity).to.equal(10);",
                  "    pm.expect(data.executedPrice).to.be.above(0);",
                  "    pm.expect(data.commission).to.equal(1);",
                  "    pm.collectionVariables.set(\"marketOrderId\", data.orderId);",
                  "});"
                ]
              }
            }
          ]
        },
